rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 3000;

      // Owner can edit; everyone signed in may only change likes / replyCount.
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replyCount'])
      );

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() <= 1500;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
